{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    // Crepe's own CodeMirror, for the rich editor's code theme; the build resolves them in scripts/codemirror-alias.ts.
    "paths": {
      "@codemirror/language": ["./node_modules/.pnpm/node_modules/@codemirror/language"],
      "@codemirror/state": ["./node_modules/.pnpm/node_modules/@codemirror/state"],
      "@codemirror/view": ["./node_modules/.pnpm/node_modules/@codemirror/view"],
      "@lezer/highlight": ["./node_modules/.pnpm/node_modules/@lezer/highlight"]
    }
  },
  "include": ["src/renderer", "src/shared/rpc.ts", "src/shared/brand.ts", "src/shared/config.ts", "src/shared/*-protocol.ts", "tests/renderer"]
}
