{
  "name": "rainy-agent",
  "productName": "RainyAgent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "RainyAgent: an AI coding workbench for CTF players on Windows and WSL2",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:host": "tsx scripts/build.ts --host-only",
    "build:release": "tsx scripts/build.ts --release",
    "dev": "tsx scripts/dev.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:node": "node --test tests/scripts/*.test.mjs",
    "package": "node scripts/prepare-shell.mjs && electron-builder --config electron-builder.config.cjs --win nsis"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vscode/ripgrep": "1.18.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.2.0",
    "node-pty": "1.2.0-beta.15",
    "prettier": "3.9.9",
    "pyright": "1.1.414",
    "tar": "^7.5.22",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.1",
    "ws": "8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "happy-dom": "^20.0.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  }
}
