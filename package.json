{
  "name": "rainy-agent",
  "productName": "Rainy",
  "version": "3.9.0",
  "private": true,
  "type": "module",
  "description": "Rainy: a lightweight AI coding workbench for Windows, WSL and remote Linux over SSH",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:host": "tsx scripts/build.ts --host-only",
    "build:release": "tsx scripts/build.ts --release",
    "dev": "tsx scripts/dev.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:node": "node --test tests/scripts/*.test.mjs",
    "package": "node scripts/prepare-shell.mjs && electron-builder --config electron-builder.config.cjs --win nsis"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@modelcontextprotocol/sdk": "1.32.0",
