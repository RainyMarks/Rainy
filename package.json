{
  "name": "rainy-agent",
  "productName": "Rainy",
  "version": "4.2.1",
  "private": true,
  "type": "module",
  "description": "Rainy: the viewer page and release scripts beside the native app in native/",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:release": "tsx scripts/build.ts --release",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:node": "node --test tests/scripts/*.test.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "docx-preview": "0.4.1",
    "happy-dom": "20.14.5",
    "highlight.js": "11.11.1",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "mermaid": "12.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tar": "7.5.22",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
