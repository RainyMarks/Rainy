    "node-pty": "1.2.0-beta.15",
    "prettier": "3.9.9",
    "pyright": "1.1.414",
    "tar": "7.5.22",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.1",
    "undici": "7.30.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
