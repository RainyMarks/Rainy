{
  "name": "rainy-agent",
  "productName": "RainyAgent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "RainyAgent: an AI coding workbench for CTF players on Windows and WSL2",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:host": "tsx scripts/build.ts --host-only",
    "build:release": "tsx scripts/build.ts --release",
    "dev": "tsx scripts/dev.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:node": "node --test tests/scripts/*.test.mjs",
    "package": "electron-builder --config electron-builder.config.cjs --win nsis"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vscode/ripgrep": "1.18.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.2.0",
    "node-pty": "1.2.0-beta.15",
    "prettier": "3.9.9",
    "pyright": "1.1.414",
    "tar": "^7.5.22",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.1",
    "ws": "8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-api": "37.1.0",
    "@codingame/monaco-vscode-configuration-service-override": "37.1.0",
    "@codingame/monaco-vscode-cpp-default-extension": "37.1.0",
    "@codingame/monaco-vscode-files-service-override": "37.1.0",
    "@codingame/monaco-vscode-json-default-extension": "37.1.0",
    "@codingame/monaco-vscode-languages-service-override": "37.1.0",
    "@codingame/monaco-vscode-python-default-extension": "37.1.0",
    "@codingame/monaco-vscode-textmate-service-override": "37.1.0",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "37.1.0",
    "@codingame/monaco-vscode-theme-service-override": "37.1.0",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "37.1.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vscode/debugprotocol": "1.68.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "happy-dom": "^20.0.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@37.1.0",
    "monaco-languageclient": "11.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "vite": "6.4.3",
    "vitest": "4.1.8",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@37.1.0",
    "vscode-languageclient": "10.1.2",
    "vscode-ws-jsonrpc": "4.0.2"
  }
